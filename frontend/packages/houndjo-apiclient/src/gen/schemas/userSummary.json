{
    "type": "object",
    "properties": {
        "id": { "type": "integer", "format": "int64" },
        "email": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\w!#$%&'*+/=?`{|}~^.-]+@[\\w.-]+\\.[a-zA-Z]{2,}$"
        },
        "phoneNumber": { "type": "string" },
        "firstName": { "type": "string", "minLength": 1 },
        "lastName": { "type": "string", "minLength": 1 },
        "birthDate": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
        "address": { "type": "string" },
        "status": {
            "type": "string",
            "enum": [
                "NOT_ACTIVATED",
                "ACTIVATED",
                "DEACTIVATED",
                "LOCKED",
                "BANNED"
            ]
        },
        "languageKey": { "type": "string" },
        "imageUrl": { "type": "string" },
        "preferences": {
            "type": "object",
            "properties": {
                "appearance": {
                    "type": "object",
                    "properties": {
                        "theme": {
                            "type": "string",
                            "enum": ["LIGHT", "DARK", "SYSTEM"]
                        },
                        "font": {
                            "type": "string",
                            "enum": ["INTER", "MANROPE", "SYSTEM"]
                        }
                    },
                    "required": ["font", "theme"],
                    "x-readme-ref-name": "AppearancePreferences"
                },
                "notifications": {
                    "type": "object",
                    "properties": {
                        "productUpdatesEnabled": { "type": "boolean" }
                    },
                    "x-readme-ref-name": "NotificationPreferences"
                },
                "display": {
                    "type": "object",
                    "properties": {
                        "textSize": {
                            "type": "string",
                            "enum": ["SMALL", "DEFAULT", "LARGE"]
                        },
                        "reduceMotion": { "type": "boolean" }
                    },
                    "required": ["textSize"],
                    "x-readme-ref-name": "DisplayPreferences"
                }
            },
            "required": ["appearance", "display", "notifications"],
            "x-readme-ref-name": "UserPreferences"
        },
        "twoFactorEnabled": { "type": "boolean" }
    },
    "required": [
        "birthDate",
        "email",
        "firstName",
        "gender",
        "lastName",
        "preferences"
    ],
    "x-readme-ref-name": "UserSummary"
}
