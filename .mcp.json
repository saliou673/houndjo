{
  "mcpServers": {
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ],
      "env": {
        "ANDROID_HOME": "${HOME}/Android/Sdk",
        "ANDROID_SDK_ROOT": "${HOME}/Android/Sdk",
        "PATH": "${HOME}/Android/Sdk/platform-tools:${HOME}/Android/Sdk/emulator:${HOME}/Android/Sdk/cmdline-tools/latest/bin:${PATH}"
      }
    }
  }
}